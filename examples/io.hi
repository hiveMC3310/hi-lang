// File I/O operations (v1.5.0+)

// ---- Write to a file ----
OPEN "test.txt" "w"
POP f
WRITELN f "Hello from Hi!"
WRITE f "This is a second line"
CLOSE f

// ---- Read entire file at once ----
OPEN "test.txt" "r"
POP f
READ f
POP content
CLOSE f
PRINT "Entire content: " content

// ---- Append a line ----
OPEN "test.txt" "a"
POP f
WRITELN f "Appended line"
CLOSE f

// ---- Read line by line with EOF check ----
OPEN "test.txt" "r"
POP f

// Prepare condition: NOT EOF f
EOF f
NOT SP
POP cond

WHILE cond
    READLN f
    POP line
    PRINT "Read: " line
    // Update condition for next iteration
    EOF f
    NOT SP
    POP cond
DO

CLOSE f