// Demonstrates file I/O and console input

// Write to a file
LET f = open("output.txt", "w")
writeln(f, "Hello, file!")
writeln(f, "Line 2")
close(f)

// Read from the file
LET f2 = open("output.txt", "r")
LET content = read(f2)
close(f2)
PRINT "File content: ", content

// Read line by line
LET f3 = open("output.txt", "r")
LET line1 = readln(f3)
LET line2 = readln(f3)
LET eof_flag = eof(f3)
LET line3 = readln(f3)   // empty if EOF
close(f3)

PRINT "Line1: ", line1
PRINT "Line2: ", line2
PRINT "EOF after line2? ", eof_flag
PRINT "Line3 (EOF): ", line3

// Console input (interactive – try typing)
PRINT "Enter your name: "
INPUT name
PRINT "Hello, ", name

// Using a prompt
INPUT "Enter your age: " age
PRINT "You are ", age, " years old."