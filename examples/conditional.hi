// Demonstrates IF...THEN...ELSE...END

LET age = 18

IF age >= 18 THEN
    PRINT "You are an adult."
ELSE
    PRINT "You are a minor."
END

LET score = 85
IF score >= 90 THEN
    PRINT "Grade: A"
ELSE
    IF score >= 80 THEN
        PRINT "Grade: B"
    ELSE
        PRINT "Grade: C or lower"
    END
END

// Boolean conditions
LET is_sunny = TRUE
IF is_sunny THEN
    PRINT "Let's go outside!"
END