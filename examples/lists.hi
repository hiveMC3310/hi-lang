// List operations (v1.4.0+)

// Create a list
LIST 1 2 3 4 5
POP mylist
PRINT "Original list: " mylist

// Length
LEN mylist
POP len
PRINT "Length: " len

// Index access
INDEX mylist 2
POP third
PRINT "Element at index 2: " third

// Append (creates new list or modifies in place with COW)
APPEND mylist 42
POP newlist
PRINT "After append: " newlist

// Insert
INSERT newlist 2 99
POP inserted
PRINT "After insert at index 2: " inserted

// Remove
REMOVE inserted 1
POP removed
PRINT "After remove at index 1: " removed

// Slice
SLICE removed 1 3
POP sliced
PRINT "Slice (1,3): " sliced

// Reverse
REVERSE removed
POP rev
PRINT "Reversed: " rev

// IndexOf
INDEXOF rev 99
POP idx
PRINT "Index of 99: " idx

INDEXOF rev 999
POP not_found
PRINT "Index of 999: " not_found

// Contains
CONTAINS rev 3
POP has
PRINT "Contains 3: " has

// The original list is unchanged (COW)
PRINT "Original list still: " mylist