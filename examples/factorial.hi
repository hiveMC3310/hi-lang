// Recursive factorial function

FUNC factorial
    // expects n on stack
    POP n
    IF EQ n 0
        PUSH 1          // base case: 0! = 1
    ELSE
        PUSH n
        SUB n 1
        CALL factorial  // recursive call
        MUL             // multiply n with factorial(n-1)
    ENDIF
    RET
ENDF

INPUT "Enter a number: " n
PUSH n
CALL factorial
POP result
PRINT "Factorial of " n " = " result