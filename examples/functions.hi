// Functions with local variables and stack operations

// Square function: expects a number on stack, returns square
FUNC square
    DUP          // duplicate top (n)
    MUL          // n * n
    RET
ENDF

PUSH 7
CALL square
POP result
PRINT "7^2 = " result

// Greet function with local variable
FUNC greet
    LET name "World"
    PRINT "Hello, " name "!"
    RET
ENDF

CALL greet